#!/bin/sh
# Opens the Hub. Starts its server first if it is not running.
#   claude-hub          open the Hub in your browser
#   claude-hub stop     stop the server
#   claude-hub --quiet  start the server without opening a browser tab
PORT="${SESSIONS_PORT:-4517}"
APP_DIR="__APP_DIR__"
NODE="__NODE__"
[ -x "$NODE" ] || NODE="$(command -v node)"
STATE="$HOME/.session-dashboard"
URL="http://127.0.0.1:$PORT"
mkdir -p "$STATE" && chmod 700 "$STATE"

if [ "$1" = "stop" ]; then
  [ -f "$STATE/server.pid" ] && kill "$(cat "$STATE/server.pid")" 2>/dev/null && echo "stopped" || echo "not running"
  rm -f "$STATE/server.pid"
  exit 0
fi

if [ -z "$NODE" ]; then
  echo "The Hub needs Node.js. Install it from https://nodejs.org, then try again."
  exit 1
fi

if ! curl -s -o /dev/null --max-time 1 "$URL/api/ping"; then
  SESSIONS_PORT="$PORT" nohup "$NODE" "$APP_DIR/server.js" >> "$STATE/server.log" 2>&1 &
  echo $! > "$STATE/server.pid"
  i=0
  while [ $i -lt 40 ] && ! curl -s -o /dev/null --max-time 1 "$URL/api/ping"; do sleep 0.25; i=$((i + 1)); done
fi

[ "$1" = "--quiet" ] || open "$URL"
echo "$URL"
